    },
    "shadow-lift": {
      "$type": "shadow",
      "$value": "0 0 0 1px rgba(255, 255, 255, 0.1), 0 12px 32px rgba(0, 0, 0, 0.5)",
      "$extensions": {
        "com.mockio": {
          "cssVariable": "--shadow-lift",
          "tailwind": "var(--shadow-lift)",
          "dark": "0 0 0 1px rgba(255, 255, 255, 0.1), 0 12px 32px rgba(0, 0, 0, 0.5)",
          "light": "0 0 0 1px rgba(29, 29, 31, 0.06), 0 6px 12px rgba(29, 29, 31, 0.06), 0 18px 40px rgba(29, 29, 31, 0.1)"
        }
      }
    },
    "shadow-float": {
      "$type": "shadow",
      "$value": "0 0 0 1px rgba(255, 255, 255, 0.08), 0 24px 64px rgba(0, 0, 0, 0.6)",
      "$extensions": {
