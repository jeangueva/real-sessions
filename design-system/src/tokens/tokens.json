{
  "$description": "Mockio design tokens. Generated from src/tokens/tokens.css by scripts/build-tokens.mjs — edit the CSS, not this file. Dark is the default theme; light applies with data-theme=\"light\" on <html>.",
  "easing": {
    "ease-out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.23, 1, 0.32, 1)",
      "$extensions": {
        "com.mockio": {
          "cssVariable": "--ease-out",
          "tailwind": "var(--ease-out)",
          "dark": "cubic-bezier(0.23, 1, 0.32, 1)"
        }
      }
    },
    "ease-drawer": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.32, 0.72, 0, 1)",
      "$extensions": {
        "com.mockio": {
          "cssVariable": "--ease-drawer",
          "tailwind": "var(--ease-drawer)",
          "dark": "cubic-bezier(0.32, 0.72, 0, 1)"
        }
      }
    }
  },
  "ink": {
    "cream": {
      "$type": "color",
      "$value": "rgb(245 245 247)",
      "$extensions": {
        "com.mockio": {
          "cssVariable": "--cream",
          "tailwind": "rgb(var(--cream) / <alpha-value>)",
          "dark": "rgb(245 245 247)",
          "light": "rgb(29 29 31)"
        }
      }
    },
    "cream-bright": {
      "$type": "color",
      "$value": "rgb(250 250 252)",
      "$extensions": {
        "com.mockio": {
          "cssVariable": "--cream-bright",
          "tailwind": "rgb(var(--cream-bright) / <alpha-value>)",
