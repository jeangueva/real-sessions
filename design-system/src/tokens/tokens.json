  "typography": {
    "$description": "The type scale from the Tailwind preset. Nothing in the interface is smaller than 14px.",
    "xs": {
      "$type": "dimension",
      "$value": "0.875rem",
      "$extensions": {
        "com.mockio": {
          "lineHeight": "1.5",
          "tailwind": "text-xs"
        }
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": "1rem",
      "$extensions": {
        "com.mockio": {
          "lineHeight": "1.55",
          "tailwind": "text-sm"
        }
      }
    },
    "base": {
      "$type": "dimension",
      "$value": "1.0625rem",
      "$extensions": {
        "com.mockio": {
          "lineHeight": "1.6",
          "tailwind": "text-base"
        }
      }
    },
    "title": {
      "$type": "dimension",
      "$value": "clamp(1.25rem, 2vw, 1.75rem)",
      "$extensions": {
        "com.mockio": {
          "lineHeight": "1.18",
          "letterSpacing": "-0.018em",
          "tailwind": "text-title"
        }
      }
    },
    "headline": {
      "$type": "dimension",
      "$value": "clamp(2rem, 4.6vw, 4rem)",
      "$extensions": {
        "com.mockio": {
          "lineHeight": "1.04",
          "letterSpacing": "-0.032em",
          "tailwind": "text-headline"
        }
      }
    },
    "display": {
      "$type": "dimension",
      "$value": "clamp(3rem, 9vw, 8rem)",
      "$extensions": {
        "com.mockio": {
          "lineHeight": "0.95",
          "letterSpacing": "-0.045em",
          "tailwind": "text-display"
        }
      }
    },
    "family": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "SF Pro Text",
        "Inter",
        "Almarai",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "radius": {
    "pill": {
      "$type": "dimension",
      "$value": "9999px",
      "$extensions": {
        "com.mockio": {
          "tailwind": "rounded-full"
        }
      }
    },
    "card": {
      "$type": "dimension",
      "$value": "1.25rem",
      "$extensions": {
        "com.mockio": {
          "tailwind": "rounded-card"
        }
      }
    },
    "inset": {
      "$type": "dimension",
      "$value": "1.75rem",
      "$extensions": {
        "com.mockio": {
          "tailwind": "rounded-inset"
        }
      }
    }
  },
  "motion": {
    "press": {
      "$type": "cubicBezier",
      "$value": [
        0.23,
        1,
        0.32,
        1
      ],
      "$extensions": {
        "com.mockio": {
          "tailwind": "ease-press",
          "use": "Every UI response: press, popover, focus halo."
        }
      }
    },
    "drawer": {
      "$type": "cubicBezier",
      "$value": [
        0.32,
        0.72,
        0,
        1
      ],
      "$extensions": {
        "com.mockio": {
          "tailwind": "ease-drawer",
          "use": "Sheets sliding from an edge."
        }
      }
    },
    "cinematic": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ],
      "$extensions": {
        "com.mockio": {
          "tailwind": "ease-cinematic",
          "use": "Page-level entrances."
        }
      }
    },
    "duration-press": {
      "$type": "duration",
      "$value": "75ms"
    },
    "duration-ui": {
      "$type": "duration",
      "$value": "150ms"
    },
    "duration-enter": {
      "$type": "duration",
      "$value": "200ms"
    }
  }
}
