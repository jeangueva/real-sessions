{
  "name": "@mockio/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mockio's design system: tokens, components with contracts, previews and documentation. React + Tailwind, importable as source.",
  "license": "UNLICENSED",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./tailwind-preset": "./src/tokens/tailwind-preset.js",
    "./tokens.json": "./src/tokens/tokens.json",
    "./registry.json": "./registry.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "registry": "tsx scripts/build-registry.ts",
    "check": "node scripts/build-tokens.mjs --check && tsx scripts/build-registry.ts --check && tsc --noEmit && vitest run",
    "test": "vitest run",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "peerDependencies": {
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "axe-core": "4.13.0",
    "framer-motion": "11.15.0",
    "happy-dom": "20.12.0",
    "lucide-react": "0.468.0",
    "marked": "18.1.1",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
