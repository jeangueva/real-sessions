# --- Credentials: set the key for whichever vendor your models come from ---

# Anthropic (claude-* models). Or run `ant auth login` and skip this.
ANTHROPIC_API_KEY=

# Google Gemini (gemini-* models).
GEMINI_API_KEY=

# Qwen via DashScope international (qwen* models).
DASHSCOPE_API_KEY=

# OpenRouter — any "vendor/model" id, e.g. deepseek/deepseek-v4-flash.
OPENROUTER_API_KEY=

# Optional: OpenRouter attribution headers (HTTP-Referer / X-Title).
# REALSESSIONS_SITE_URL=https://realsessions.app
# REALSESSIONS_APP_NAME=Real Sessions

# --- API server ---
# Redis holds interviews in progress. Required in production: without it a
# restart discards every interview in flight. Locally, leaving it unset falls
# back to memory with a warning.
REDIS_URL=redis://localhost:6379

# Postgres holds everything durable: transcripts with their timings, derived
# metrics, XP and badges. Required in production — progress over months is the
# product, and a store with a TTL cannot express it. Locally, leaving it unset
# falls back to per-process memory with a warning.
DATABASE_URL=postgresql://localhost:5432/realsessions


# Signs identity cookies. REQUIRED in production (≥32 chars) — the server
# refuses to start without it when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REALSESSIONS_SESSION_SECRET=

# Optional shared code gating who can obtain an identity. Leave empty for open
# access; set it to run a closed beta.
# REALSESSIONS_ACCESS_CODE=

# Set to 1 only when behind a proxy you control, so X-Forwarded-For is trusted
# for rate limiting. Off by default — otherwise any caller can rotate the
# header and mint unlimited identities.
# REALSESSIONS_TRUST_PROXY=1

# Base URL used in reset and confirmation links. Defaults to http://localhost:5173.
# REALSESSIONS_SITE_URL=https://realsessions.app

# Email delivery (Resend). BOTH are required, or the server falls back to
# printing links to the log — and refuses to start at all in production.
# The from address must be on a domain verified with the provider, or every
# send is rejected with 422.
RESEND_API_KEY=
EMAIL_FROM=Real Sessions <no-reply@example.com>

# --- Model selection (optional) ---
# Both phases default to qwen/qwen3.7-flash via OpenRouter, picked by the
# benchmark on 2026-08-30: 0 rule failures in Phase 1, 5/5 L1 errors caught in
# Phase 2, ~$0.00033 per interview. Reproduce with `npm run benchmark`.
#
# REALSESSIONS_INTERVIEWER_MODEL=qwen/qwen3.7-flash
# REALSESSIONS_EVALUATOR_MODEL=qwen/qwen3.7-flash
#
# REALSESSIONS_MODEL overrides BOTH phases at once.
# REALSESSIONS_MODEL=anthropic/claude-sonnet-5

# --- Live transcription (optional) ---
# Deepgram streaming speech-to-text. Without it the browser's own
# SpeechRecognition is used, which Chrome routes through Google's servers and
# Firefox does not implement at all. The key stays server-side: the browser
# talks to /api/voice over a WebSocket and never sees it.
DEEPGRAM_API_KEY=
